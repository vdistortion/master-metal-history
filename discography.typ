#let album-cover(title, artwork: none, width: 46mm) = {
  if artwork != none {
    image(artwork, width: width)
  } else {
    rect(
      width: width,
      height: width,
      fill: luma(97%),
      stroke: 0.5pt + luma(65%),
      inset: 3mm,
    )[
      #set align(center + horizon)
      #set text(font: "Nimbus Sans", size: 7pt, fill: luma(45%), hyphenate: false)
      ОБЛОЖКА
      #v(2mm)
      #text(size: 9pt, weight: "bold", title)
      #v(2mm)
      Изображение будет добавлено
    ]
  }
}

#let track-list(tracks) = {
  set text(size: 10pt, weight: "bold", hyphenate: false)
  set align(left)
  set par(justify: false, leading: 0.35em, spacing: 0pt)
  set enum(numbering: "1.", indent: 0pt, body-indent: 0.5em, spacing: 2mm, tight: false)
  if tracks.len() > 12 {
    let split = calc.ceil(tracks.len() / 2)
    grid(
      columns: (1fr, 1fr),
      column-gutter: 5mm,
      enum(..tracks.slice(0, split)),
      enum(start: split + 1, ..tracks.slice(split)),
    )
  } else {
    align(center, block(width: 84mm, align(left, enum(..tracks))))
  }
}

#let album(
  title,
  release,
  tracks: (),
  artwork: none,
  cover-width: 46mm,
  bonus: none,
  body,
) = page[
  #align(center)[
    #heading(level: 2, title)
    #text(size: 9pt, release)
  ]
  #v(5mm)
  #align(center)[
    #album-cover(title, artwork: artwork, width: cover-width)
  ]
  #v(5mm)
  #if tracks.len() > 0 {
    track-list(tracks)
  }
  #if bonus != none {
    block(above: 2mm)[
      #set text(size: 9pt)
      #bonus
    ]
  }
  #v(1fr)
  #block(above: 4mm)[
    #set text(size: 9pt)
    #set par(leading: 0.35em, spacing: 0.5em)
    #body
  ]
]

