#let musician(name, entries) = {
  heading(level: 2, name)
  for (year, release) in entries {
    block(breakable: false, below: 1.5mm)[
      #grid(
        columns: (18mm, 1fr),
        column-gutter: 2mm,
        text(weight: "bold", year), release,
      )
    ]
  }
}

